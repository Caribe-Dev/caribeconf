---
/**
 * Página 404 por defecto. Usa el layout `src/layouts/Main.astro` de la app
 * que la importa, así hereda su edición (GA), estilos y header/footer.
 *
 *   // src/pages/404.astro
 *   import NotFound from '@shared/sections/NotFound.astro'
 *   <NotFound />
 *
 * La app debe tener `public/caribe-dev-white-logo.png`.
 */
import { Image } from 'astro:assets';
import Main from '@/layouts/Main.astro';
import Glow from '@shared/components/Glow.astro'

import CaribeDevPng from '@/public/caribe-dev-white-logo.png';
---
<Main title="Página no encontrada">
  <main class="h-dvh flex justify-center">
    <div class="flex flex-col items-center gap-4 mt-[30%] md:mt-[10%]">
      <Image class='max-w-[180px] md:max-w-[280px]' src={CaribeDevPng} alt='Caribe dev logo' />
      <h1 class="text-center">404 <br> Página no encontrada.</h1>
      <p>
        Estamos trabajando en la próxima edición de CaribeConf. ¡Mantente atento para más detalles!
      </p>
    </div>
  </main>
  <Glow />
</Main>

<style>
  body {
    margin: 0;
    min-height: 100dvh;
    background-color: #0E1217;
    position: relative;
    overflow: hidden;
  }
</style>
