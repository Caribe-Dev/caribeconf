---
/** Hero con la escena de playa y el degradado de ocaso de caribeconf.com.
 *
 *  El texto vive en la franja superior (azul/morado), donde el blanco da 7:1 y
 *  5.4:1. En las paradas cálidas cae a 2.3:1, así que esa zona solo lleva la
 *  ilustración — igual que en el sitio original.
 */
interface Props {
  eyebrow: string
  titulo: string
  /** Párrafos de la entradilla. Admiten HTML para resaltar cifras. */
  parrafos: string[]
}
const { eyebrow, titulo, parrafos } = Astro.props
---

<section class="hero-ocaso relative isolate overflow-hidden">
  {/* Escenario, de fondo a frente. aria-hidden: es decoración, no información. */}
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <img
      src="/images/sol.png"
      alt=""
      class="absolute top-[38%] left-1/2 w-[560px] max-w-none -translate-x-1/2 opacity-90 md:w-[760px]"
    />
    <img
      src="/images/clouds.svg"
      alt=""
      class="absolute top-[30%] left-0 w-full opacity-70"
    />
    <img
      src="/images/birds.svg"
      alt=""
      class="absolute top-[16%] right-[12%] w-[110px] opacity-60 md:w-[150px]"
    />
    <img
      src="/images/muelle-puente.svg"
      alt=""
      class="absolute bottom-[58px] left-0 w-full opacity-80"
    />
    <img
      src="/images/agua.png"
      alt=""
      class="absolute bottom-0 left-0 h-[120px] w-full object-cover"
    />
    <img
      src="/images/balsa-1.png"
      alt=""
      class="absolute bottom-[52px] left-[8%] w-[120px] opacity-90 md:w-[170px]"
    />
    <img
      src="/images/playa.png"
      alt=""
      class="absolute bottom-0 left-0 h-[52px] w-full object-cover"
    />
    {/* Las palmeras solo en desktop: en móvil se comen el ancho útil. */}
    <img
      src="/images/palmeras-izquierda.png"
      alt=""
      class="absolute bottom-0 left-0 hidden w-[170px] lg:block xl:w-[230px]"
    />
    <img
      src="/images/palmeras-derecha.png"
      alt=""
      class="absolute right-0 bottom-0 hidden w-[170px] lg:block xl:w-[230px]"
    />
  </div>

  <div class="mx-auto max-w-7xl px-4 pt-12 pb-[190px] md:pt-16 md:pb-[230px]">
    <img
      src="/caribe-dev-white-logo.svg"
      alt="CaribeDev"
      width="65"
      height="34"
      class="max-w-[65px]"
    />
    <p class="mt-8 text-sm font-bold tracking-[2px] text-white uppercase">
      {eyebrow}
    </p>
    <h1 class="xs:text-5xl mt-4 max-w-3xl text-4xl font-bold md:text-6xl">
      {titulo}
    </h1>
    {/* Panel translúcido: la entradilla cae sobre las palmeras y las paradas
        cálidas del ocaso, donde el blanco solo da 2.3:1. Este velo lo sube a
        6.3:1 en el peor punto sin tapar la ilustración. */}
    {/* Dos columnas en desktop: en una sola el panel se hace muy alto y empuja
        las métricas fuera de la primera pantalla. */}
    <div
      class="panel-entradilla mt-8 max-w-5xl rounded-2xl border border-white/15 px-6 py-6 md:px-8 md:py-7"
    >
      <div class="grid gap-x-8 gap-y-4 md:grid-cols-2">
        {
          parrafos.map((parrafo: string) => (
            <p class="text-base leading-relaxed text-white md:text-lg">
              <Fragment set:html={parrafo} />
            </p>
          ))
        }
      </div>
    </div>
  </div>

  {/* Ola que empalma el ocaso con el fondo oscuro del resto de la página. */}
  <svg
    class="absolute -bottom-px left-0 w-full"
    viewBox="0 0 1440 69"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      fill="#120B2F"
      d="M0 69h1440V26c-60 14-140 22-240 14S1010 8 900 14 700 44 580 40 320 8 200 12 40 30 0 40z"
    ></path>
  </svg>
</section>
