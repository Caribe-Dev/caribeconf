---
import type { Comparativo } from '../data/types'

/** Tabla de la gráfica comparativa 2025 vs 2026.
 *
 *  Se compara prevalencia, no frecuencia: las bases son distintas (306 vs 386),
 *  así que "142 contra 184" no dice nada mientras "46.4% contra 47.7%" sí. La
 *  última columna es el cambio en puntos porcentuales.
 */
interface Props {
  comparativo: Comparativo
  base2025: number
  base2026: number
  encabezado?: string
}
const { comparativo, base2025, base2026, encabezado = 'Nivel' } = Astro.props

const pct = (v: number | null, base: number) =>
  v == null ? null : Math.round((1000 * v) / base) / 10

const filas = comparativo.orden.map((nombre) => {
  const n25 = comparativo['2025'][nombre]
  const n26 = comparativo['2026'][nombre]
  const p25 = pct(n25, base2025)
  const p26 = pct(n26, base2026)
  return {
    nombre,
    n25,
    n26,
    p25,
    p26,
    delta: p25 == null || p26 == null ? null : Math.round((p26 - p25) * 10) / 10,
  }
})

// Qué prevalece en cada año, por separado: puede no ser el mismo nivel.
const max25 = Math.max(...filas.map((f) => f.p25 ?? -1))
const max26 = Math.max(...filas.map((f) => f.p26 ?? -1))
---

<details class="mt-5 text-sm">
  <summary class="cursor-pointer text-white/80 hover:text-white">
    Ver datos en tabla
  </summary>
  <div class="overflow-x-auto">
    <table class="mt-3 w-full min-w-[420px] text-left">
      <caption class="sr-only">
        Prevalencia de cada {encabezado.toLowerCase()} en 2025 y 2026, con el
        cambio en puntos porcentuales.
      </caption>
      <thead>
        <tr class="border-b border-white/15 text-white/80">
          <th scope="col" class="py-1 font-medium">{encabezado}</th>
          <th scope="col" class="py-1 text-right font-medium">2025</th>
          <th scope="col" class="py-1 text-right font-medium">2026</th>
          <th scope="col" class="py-1 text-right font-medium">Cambio</th>
        </tr>
      </thead>
      <tbody>
        {
          filas.map((f) => (
            <tr class="border-b border-white/5">
              <td class="py-1">
                {f.nombre}
                {f.p26 != null && f.p26 === max26 && (
                  <span class="ml-2 rounded bg-aqua/20 px-1.5 py-0.5 text-xs font-bold text-aqua">
                    prevalece
                  </span>
                )}
                {f.p25 != null && f.p25 === max25 && f.p25 !== max26 && (
                  <span class="ml-2 rounded bg-pink/25 px-1.5 py-0.5 text-xs font-bold text-white">
                    prevalecía en 2025
                  </span>
                )}
              </td>
              <td class="py-1 text-right tabular-nums text-white/85">
                {f.p25 == null ? (
                  <span class="text-warm">no se preguntó</span>
                ) : (
                  <>
                    {f.p25}% <span class="text-white/60">({f.n25})</span>
                  </>
                )}
              </td>
              <td class="py-1 text-right tabular-nums text-white/85">
                {f.p26 == null ? '—' : <>{f.p26}% <span class="text-white/60">({f.n26})</span></>}
              </td>
              <td class="py-1 text-right tabular-nums">
                {
                  f.delta == null ? (
                    '—'
                  ) : (
                    <span class={f.delta >= 0 ? 'text-aqua' : 'text-warm'}>
                      {f.delta > 0 ? '+' : ''}{f.delta} pp
                    </span>
                  )
                }
              </td>
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr class="border-t border-white/15 text-white/70">
          <td class="py-1 font-medium">Base</td>
          <td class="py-1 text-right tabular-nums">{base2025}</td>
          <td class="py-1 text-right tabular-nums">{base2026}</td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <p class="mt-2 text-white/70">
    Se comparan porcentajes y no conteos, porque las bases de los dos años son
    distintas. «pp» son puntos porcentuales de diferencia.
  </p>
</details>
