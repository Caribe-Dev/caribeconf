---
/** Equivalente tabular de una gráfica de conteos.
 *
 *  Todas las gráficas del sitio llevan su tabla, para que la estructura sea la
 *  misma en todas y los valores exactos no dependan de leer una barra.
 *
 *  La columna de prevalencia es la proporción de la muestra que cae en cada
 *  categoría, y la categoría que prevalece va marcada.
 */
interface Props {
  filas: [string, number | null][]
  base: number
  encabezado?: string
  /** Solo para escalas ordinales: añade la prevalencia acumulada. En una
   *  variable nominal acumular no significa nada, así que va apagado. */
  acumulado?: boolean
  /** Multi-respuesta: la prevalencia no suma 100% y no se puede acumular. */
  multiRespuesta?: boolean
  unidad?: string
}
const {
  filas,
  base,
  encabezado = 'Categoría',
  acumulado = false,
  multiRespuesta = false,
  unidad = 'registros',
} = Astro.props

const pct = (v: number) => Math.round((1000 * v) / base) / 10

// La categoría que prevalece: la de mayor frecuencia.
const maximo = Math.max(...filas.map(([, v]) => v ?? -1))

// Acumulado solo tiene sentido en ordinales y nunca en multi-respuesta.
const conAcumulado = acumulado && !multiRespuesta
let corrido = 0
const conValores = filas.map(([nombre, valor]) => {
  if (valor != null) corrido += valor
  return { nombre, valor, acumuladoPct: valor == null ? null : pct(corrido) }
})
---

<details class="mt-5 text-sm">
  <summary class="cursor-pointer text-white/80 hover:text-white">
    Ver datos en tabla
  </summary>
  <table class="mt-3 w-full text-left">
    <caption class="sr-only">
      Frecuencia y prevalencia de cada {encabezado.toLowerCase()} sobre {base}
      {unidad}.
    </caption>
    <thead>
      <tr class="border-b border-white/15 text-white/80">
        <th scope="col" class="py-1 font-medium">{encabezado}</th>
        <th scope="col" class="py-1 text-right font-medium">n</th>
        <th scope="col" class="py-1 text-right font-medium">Prevalencia</th>
        {
          conAcumulado && (
            <th scope="col" class="py-1 text-right font-medium">Acumulada</th>
          )
        }
      </tr>
    </thead>
    <tbody>
      {
        conValores.map(({ nombre, valor, acumuladoPct }) => {
          const prevalece = valor != null && valor === maximo
          return (
            <tr class="border-b border-white/5">
              <td class="py-1">
                {nombre}
                {prevalece && (
                  <span class="ml-2 rounded bg-aqua/20 px-1.5 py-0.5 text-xs font-bold text-aqua">
                    prevalece
                  </span>
                )}
              </td>
              <td class="py-1 text-right tabular-nums">{valor ?? '—'}</td>
              <td
                class:list={[
                  'py-1 text-right tabular-nums',
                  prevalece ? 'font-bold text-white' : 'text-white/85',
                ]}
              >
                {valor == null ? '—' : `${pct(valor)}%`}
              </td>
              {conAcumulado && (
                <td class="py-1 text-right tabular-nums text-white/70">
                  {acumuladoPct == null ? '—' : `${acumuladoPct}%`}
                </td>
              )}
            </tr>
          )
        })
      }
    </tbody>
    <tfoot>
      <tr class="border-t border-white/15 text-white/70">
        <td class="py-1 font-medium">Total</td>
        <td class="py-1 text-right tabular-nums">
          {conValores.reduce((s, f) => s + (f.valor ?? 0), 0)}
        </td>
        <td class="py-1 text-right tabular-nums" colspan={conAcumulado ? 2 : 1}>
          {
            multiRespuesta
              ? `sobre ${base} ${unidad}`
              : `${base} ${unidad}`
          }
        </td>
      </tr>
    </tfoot>
  </table>
  {
    multiRespuesta && (
      <p class="mt-2 text-white/70">
        Cada persona pudo marcar varias opciones, así que la prevalencia suma más
        de 100% y no se puede acumular.
      </p>
    )
  }
</details>
