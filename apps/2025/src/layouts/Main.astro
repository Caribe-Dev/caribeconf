---
import { DOMAIN } from "astro:env/client"
import BaseLayout from '@shared/layouts/BaseLayout.astro'

import Header from '@/sections/Header.astro'
import Footer from '@/sections/Footer.astro'

import '@/styles/global.css'


interface Props {
  title?: string
}

const title = Astro.props.title
const image = DOMAIN + '/images/og.png'

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "CaribeConf Barranquilla, Colombia 2025",
  "startDate": "2025-04-26",
  "endDate": "2025-04-26",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "CaribeConf Barranquilla, Colombia 2025",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Calle 58 # 54-59",
      "addressLocality": "Barranquilla",
      "postalCode": "080002",
      "addressCountry": "CO"
    }
  },
  "image": image,
  "description": "Conferencia de Comunidades Tech en Barranquilla, Colombia (26 de Abril 2025)",
  "organizer": {
    "@type": "Organization",
    "name": "CaribeConf Barranquilla, Colombia 2025",
    "url": DOMAIN
  }
}
---

<BaseLayout
  edition="2025"
  title={
    title
      ? title + ' | Caribe Conf 2025'
      : 'Caribe Conf - Conferencia de Comunidades Tech en Barranquilla, Colombia (26 de Abril 2025)'
  }
  description="Únete a CaribeConf Barranquilla, Colombia 2025, la conferencia más importante sobre JavaScript en Barranquilla, el 26 de Abril 2025. ¡Ven no te lo pierdas y reserva tu entrada ahora!"
  socialTitle="CaribeConf Barranquilla, Colombia 2025"
  socialDescription="Conferencia de Comunidades Tech en Barranquilla, Colombia (26 de Abril 2025)"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Header />
  <slot />
  <Footer />
</BaseLayout>
